# AWS deployment environment variables
# Copy to .env and customize

AWS_ACCOUNT_ID=your-account-id
AWS_REGION=us-east-1
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
ENCIRONMENT=prod
CLUSTER_NAME=otel-observability

# ECS configuration
VPC_ID=vpc-xxxxx
SUBNET_IDS="subnet-xxxxx,subnet-xxxxx"

# Database
DATABASE_ENDPOINT=db.example.us-east-1.rds.amazonaws.com
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# OTel Collector
OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4318

# Service URLs (internal)
SERVICE_B_URL=http://service-b:8000

# CloudWatch
LOG_GROUP_SERVICE_A=/ecs/otel-observability/service-a
LOG_GROUP_SERVICE_B=/ecs/otel-observability/service-b
LOG_GROUP_COLLECTOR=/ecs/otel-observability/collector
